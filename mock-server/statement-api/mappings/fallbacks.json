{
  "mappings": [
    {
      "priority": 9,
      "request": {
        "method": "GET",
        "urlPathPattern": "/accounts/[^/]+/transactions",
        "headers": {
          "X-API-Key": {
            "equalTo": "statement-key"
          }
        }
      },
      "response": {
        "status": 404
      }
    },
    {
      "priority": 10,
      "request": {
        "urlPathPattern": "/accounts/.*",
        "headers": {
          "X-API-Key": {
            "absent": true
          }
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/problem+json"
        },
        "jsonBody": {
          "type": "about:blank",
          "title": "Unauthorized",
          "status": 401,
          "detail": "A valid X-API-Key header is required."
        }
      }
    },
    {
      "priority": 10,
      "request": {
        "urlPathPattern": "/accounts/.*",
        "headers": {
          "X-API-Key": {
            "doesNotMatch": "^statement-key$"
          }
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/problem+json"
        },
        "jsonBody": {
          "type": "about:blank",
          "title": "Unauthorized",
          "status": 401,
          "detail": "A valid X-API-Key header is required."
        }
      }
    }
  ]
}
